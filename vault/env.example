# Copy this file to  .env  (same folder) and fill in your keys.
#   copy secrets\.env.example secrets\.env
#   notepad secrets\.env
# One KEY=value per line, no quotes, no spaces around the = sign.
# Lines starting with # are ignored. Never share or commit the real .env.

# Adzuna  (https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch via RapidAPI  (free tier: 200 calls a month)
JSEARCH_API_KEY=

# JobsPipe  (free tier: 1,000 jobs a month)
JOBSPIPE_API_KEY=
